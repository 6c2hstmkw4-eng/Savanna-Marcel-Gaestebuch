<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#fbf7f5">
  <title>Savanna & Marcel – Unser Hochzeits-Gästebuch</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Great+Vibes&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --wine: #762e45;
      --rose: #c88e9b;
      --blush: #f5e8e8;
      --paper: #fffdfb;
      --ink: #41353a;
      --muted: #82747a;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      color: var(--ink);
      background:
        radial-gradient(ellipse at top left, #f6e8e7 0, transparent 45%),
        #fbf7f5;
      font-family: 'Montserrat', sans-serif;
      font-size: 14px;
      line-height: 1.8;
    }

    .page {
      width: min(760px, 92%);
      margin: 32px auto;
      padding: clamp(22px, 6vw, 58px);
      background: var(--paper);
      border: 1px solid #e8d4d6;
      box-shadow: 0 12px 45px #6b394012;
      position: relative;
    }

    .frame {
      border: 1px solid #d9b6bd;
      padding: clamp(18px, 4vw, 38px);
      position: relative;
    }

    .eyebrow {
      text-align: center;
      text-transform: uppercase;
      letter-spacing: 4px;
      font-size: 10px;
      color: var(--wine);
    }

    header { text-align: center; padding: 18px 0 30px; }

    .names {
      font-family: 'Great Vibes', cursive;
      color: var(--wine);
      font-size: clamp(52px, 10vw, 82px);
      line-height: 1.3;
      margin: 12px 0;
      font-weight: 400;
    }

    .ampersand { color: var(--rose); }

    .date {
      letter-spacing: 5px;
      font-size: 12px;
      color: var(--wine);
      margin-top: 16px;
    }

    .flourish {
      color: var(--rose);
      text-align: center;
      font-size: 24px;
      margin: 6px 0 18px;
    }

    h1, h2, h3 {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 500;
    }

    h1 {
      text-align: center;
      color: var(--wine);
      font-size: clamp(34px, 6vw, 46px);
      line-height: 1.15;
      margin: 8px 0;
    }

    .intro {
      text-align: center;
      max-width: 480px;
      margin: 0 auto 28px;
      color: var(--muted);
    }

    .section-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 25px;
      color: var(--wine);
      margin: 30px 0 14px;
      border-bottom: 1px solid #ead6d9;
      padding-bottom: 7px;
    }

    .field { margin: 20px 0; }

    label, .question {
      display: block;
      font-weight: 500;
      margin-bottom: 8px;
    }

    .hint {
      color: var(--muted);
      font-size: 12px;
      margin-top: -4px;
      margin-bottom: 8px;
    }

    input[type="text"],
    textarea,
    select {
      width: 100%;
      border: 1px solid #dfcbd0;
      border-radius: 0;
      background: #fff;
      color: var(--ink);
      font: inherit;
      padding: 12px 13px;
      outline: none;
    }

    input:focus, textarea:focus, select:focus {
      border-color: var(--rose);
      box-shadow: 0 0 0 2px #c88e9b20;
    }

    textarea { min-height: 105px; resize: vertical; }

    .checks {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
      gap: 10px;
    }

    .check {
      display: flex;
      align-items: flex-start;
      gap: 9px;
      border: 1px solid #eadadd;
      padding: 10px;
      background: #fffafa;
      font-weight: 400;
      margin: 0;
    }

    input[type="checkbox"] {
      accent-color: var(--wine);
      margin-top: 5px;
    }

    .upload {
      display: block;
      padding: 16px;
      border: 1px dashed #c99da7;
      background: #fffafa;
      cursor: pointer;
      text-align: center;
    }

    .upload input { display: block; margin: 12px auto 0; max-width: 100%; }

    #preview {
      display: none;
      width: 100%;
      max-height: 360px;
      object-fit: contain;
      margin-top: 14px;
    }

    .notice {
      background: #f8eeee;
      border-left: 3px solid var(--rose);
      padding: 13px 15px;
      font-size: 12px;
      color: #70565f;
      margin: 22px 0;
    }

    button {
      display: block;
      width: 100%;
      border: 1px solid var(--wine);
      background: var(--wine);
      color: white;
      padding: 15px 18px;
      font: inherit;
      letter-spacing: 1px;
      cursor: pointer;
      transition: .2s;
      margin-top: 16px;
    }

    button:hover { background: #592034; }

    .secondary {
      background: transparent;
      color: var(--wine);
    }

    .secondary:hover { background: var(--blush); }

    #status {
      text-align: center;
      color: var(--wine);
      margin-top: 15px;
    }

    footer {
      text-align: center;
      padding-top: 30px;
      color: var(--muted);
      font-size: 11px;
      letter-spacing: 1px;
    }

    footer .signature {
      font-family: 'Great Vibes', cursive;
      font-size: 31px;
      color: var(--wine);
      letter-spacing: 0;
    }

    @media (max-width: 480px) {
      .page { margin: 12px auto; width: 96%; padding: 12px; }
      .frame { padding: 18px 14px; }
      .date { letter-spacing: 3px; }
    }
  </style>
</head>

<body>
  <main class="page">
    <div class="frame">
      <header>
        <div class="eyebrow">Wir heiraten</div>
        <div class="names">Savanna <span class="ampersand">&</span> Marcel</div>
        <div class="flourish">✧ ❦ ✧</div>
        <div class="date">02 · JULI · 2027</div>
      </header>

      <div class="eyebrow">Ein Tag voller Erinnerungen</div>
      <h1>Unser digitales Gästebuch</h1>

      <p class="intro">
        Wie schön, dass du Teil unserer Geschichte bist!
        Wir möchten diesen besonderen Tag und all die Menschen,
        die ihn unvergesslich machen, in Erinnerung behalten.
        Teile ein paar Gedanken, eine schöne Erinnerung oder
        einen Wunsch für unsere gemeinsame Zukunft mit uns.
      </p>

      <div class="flourish">♡</div>

      <form id="guestbook">
        <div class="section-title">01 — Ein paar Worte zu dir</div>

        <div class="field">
          <label for="guest">Dein Name *</label>
          <input id="guest" name="Name" type="text"
                 placeholder="Wie dürfen wir dich nennen?" required>
        </div>

        <div class="field">
          <div class="question">Wie kennen wir uns?</div>
          <div class="hint">Du kannst mehrere Antworten auswählen.</div>
          <div class="checks">
            <label class="check"><input type="checkbox" name="Beziehung" value="Familie Savanna"> Familie von Savanna</label>
            <label class="check"><input type="checkbox" name="Beziehung" value="Familie Marcel"> Familie von Marcel</label>
            <label class="check"><input type="checkbox" name="Beziehung" value="Freundeskreis"> Freundeskreis</label>
            <label class="check"><input type="checkbox" name="Beziehung" value="Arbeit"> Arbeit</label>
            <label class="check"><input type="checkbox" name="Beziehung" value="Schon lange dabei"> Schon lange Teil unserer Geschichte</label>
            <label class="check"><input type="checkbox" name="Beziehung" value="Sonstiges"> Auf andere Weise</label>
          </div>
        </div>

        <div class="section-title">02 — Erinnerungen, die bleiben</div>

        <div class="field">
          <label for="memory">Welche schöne, lustige oder besondere Erinnerung hast du mit uns?</label>
          <textarea id="memory" name="Erinnerung" placeholder="Erzähl uns deine Geschichte …"></textarea>
        </div>

        <div class="field">
          <label for="appreciation">Was verbindest du mit uns als Paar?</label>
          <textarea id="appreciation" name="Was uns ausmacht" placeholder="Ein Gedanke, ein Gefühl oder eine kleine Anekdote …"></textarea>
        </div>

        <div class="section-title">03 — Für unseren gemeinsamen Weg</div>

        <div class="field">
          <label for="wish">Was wünschst du uns für unsere Zukunft?</label>
          <textarea id="wish" name="Zukunftswunsch" placeholder="Dein Wunsch für unser gemeinsames Leben …"></textarea>
        </div>

        <div class="field">
          <label for="advice">Dein bester Ehe-Tipp oder ein Rat fürs Leben zu zweit?</label>
          <textarea id="advice" name="Ratschlag" placeholder="Wir sind gespannt auf deine Weisheit …"></textarea>
        </div>

        <div class="field">
          <label for="message">Gibt es noch etwas, das du uns sagen möchtest?</label>
          <textarea id="message" name="Nachricht" placeholder="Alles, was du uns mitgeben möchtest …"></textarea>
        </div>

        <div class="section-title">04 — Ein Bild für die Erinnerung</div>

        <div class="field">
          <label class="upload">
            <strong>📷 Ein Foto auswählen</strong>
            <div class="hint">Wähle ein Bild aus deiner Fotomediathek.</div>
            <input id="photo" type="file" accept="image/*">
            <img id="preview" alt="Vorschau deines ausgewählten Fotos">
          </label>
          <div class="hint">Das Foto wird hier nur auf deinem Gerät angezeigt und nicht hochgeladen.</div>
        </div>

        <div class="field">
          <label class="check">
            <input type="checkbox" id="permission" name="Magazinfreigabe">
            <span>Ich bin damit einverstanden, dass meine Antworten für unser privates Hochzeitsmagazin verwendet werden. Bitte fragt mich vor einer öffentlichen Veröffentlichung noch einmal.</span>
          </label>
        </div>

        <div class="notice">
          <strong>Ein kleiner Hinweis:</strong> Deine Antworten werden nicht automatisch an uns gesendet.
          Mit dem Button unten kannst du sie als Textdatei auf deinem Gerät speichern und uns anschließend selbst schicken.
          Das ausgewählte Foto wird nicht in die Textdatei übernommen.
        </div>

        <button type="submit">Meine Antworten speichern ♡</button>
        <button type="button" class="secondary" id="reset">Formular leeren</button>
        <p id="status" role="status" aria-live="polite"></p>
      </form>

      <footer>
        <div class="flourish">✧</div>
        MIT LIEBE GESAMMELT
        <div class="signature">Savanna & Marcel</div>
        02. JULI 2027
      </footer>
    </div>
  </main>

  <script>
    const form = document.getElementById('guestbook');
    const photo = document.getElementById('photo');
    const preview = document.getElementById('preview');
    const status = document.getElementById('status');

    photo.addEventListener('change', function () {
      const file = this.files && this.files[0];

      if (!file) {
        preview.removeAttribute('src');
        preview.style.display = 'none';
        return;
      }

      if (!file.type.startsWith('image/')) {
        alert('Bitte wähle eine Bilddatei aus.');
        this.value = '';
        return;
      }

      const reader = new FileReader();
      reader.onload = function (event) {
        preview.src = event.target.result;
        preview.style.display = 'block';
      };
      reader.readAsDataURL(file);
    });

    form.addEventListener('submit', function (event) {
      event.preventDefault();

      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const lines = [
        'HOCHZEITS-GÄSTEBUCH',
        'Savanna & Marcel — 02. Juli 2027',
        '',
        'Name: ' + (data.get('Name') || ''),
        'Wie wir uns kennen: ' + (data.getAll('Beziehung').join(', ') || 'Keine Angabe'),
        '',
        'Erinnerung:',
        data.get('Erinnerung') || '',
        '',
        'Was uns ausmacht:',
        data.get('Was uns ausmacht') || '',
        '',
        'Zukunftswunsch:',
        data.get('Zukunftswunsch') || '',
        '',
        'Ratschlag:',
        data.get('Ratschlag') || '',
        '',
        'Nachricht:',
        data.get('Nachricht') || '',
        '',
        'Verwendung im privaten Hochzeitsmagazin: ' +
          (document.getElementById('permission').checked ? 'Ja' : 'Nicht zugestimmt'),
        '',
        'Hinweis: Ein ausgewähltes Foto ist nicht in dieser Datei enthalten.'
      ];

      const blob = new Blob(
        ['\uFEFF' + lines.join('\n')],
        { type: 'text/plain;charset=utf-8' }
      );

      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      const safeName = (data.get('Name') || 'Gast')
        .toString().trim().replace(/[^a-z0-9äöüß_-]/gi, '_');

      link.href = url;
      link.download = 'Gaestebuch_' + safeName + '.txt';
      document.body.appendChild(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);

      status.textContent =
        'Deine Textdatei wurde zum Speichern bereitgestellt. Schicke sie anschließend bitte an das Brautpaar.';
    });

    document.getElementById('reset').addEventListener('click', function () {
      if (!confirm('Möchtest du alle Eingaben wirklich löschen?')) return;
      form.reset();
      preview.removeAttribute('src');
      preview.style.display = 'none';
      status.textContent = '';
    });
  </script>
</body>
</html>
